# This file provides common configuration information for building
# chromium-browser packages for various platforms.

# Base name of the package. Must keep a "vendor-" prefix (not just "cipher")
# -- xdg-icon-resource, invoked from postinst using this value as the icon
# theme name, rejects icon names with no vendor-prefix dash (confirmed via
# the Step 5 Docker install test: "icon name 'cipher' does not have a
# proper vendor prefix").
PACKAGE="cipher-browser"

# Filename of the main executable (for generating launcher scripts, etc.)
PROGNAME=brave

# Base directory for package installation.
INSTALLDIR=/opt/cipher.com/cipher-browser

# Directory for device policy enrollments.
ENROLLMENTDIR=/etc/cipher-browser/policies/enrollment

# Display string for desktop menu/icon.
MENUNAME="Cipher"

# Brief package description.
SHORTDESC="The web browser from Cipher"

# Detailed package description.
FULLDESC="Enjoy Cipher's industry-leading privacy, adblock, and speed (via Cipher Shields), but minus the extra features."

# Package maintainer information.
MAINTNAME="Cipher Software"
MAINTMAIL="support@cipher.com"
PRODUCTURL="https://cipher.com/"

RDN="com.cipher.Browser"
