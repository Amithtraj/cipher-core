import("//build/buildflag_header.gni")

declare_args() {
  # Re-enabled for SecureOut (2026-09-03, Android hardening Task 6): this is
  # Chromium/Brave's general component-updater/extension-updater delivery
  # channel, and it is the *only* channel Shields' ad/tracker/cosmetic
  # filter lists ship through -- disabling it (originally done here as part
  # of the broader Sync/stats/variations/services-key lockdown) silently
  # killed all filter-list-dependent Shields blocking. Re-pointed at
  # Brave's real endpoints so filter lists can update again. This is a
  # narrow, scoped reconnection of this one delivery channel only: Sync,
  # variations, stats-updater, and the Brave-services-key header remain
  # disabled via their own separate, independent mechanisms (see
  # components/brave_sync/BUILD.gn, components/variations/buildflags.gni,
  # browser/brave_stats/buildflags.gni, and
  # browser/net/brave_service_key_network_delegate_helper.cc) and are
  # unaffected by this change.
  updater_dev_endpoint = "https://go-updater-dev.bravesoftware.com/extensions"
  updater_prod_endpoint = "https://go-updater.brave.com/extensions"
}

if (is_official_build) {
  assert(updater_dev_endpoint != "")
  assert(updater_prod_endpoint != "")
}

buildflag_header("buildflags") {
  header = "buildflags.h"
  flags = [
    "UPDATER_DEV_ENDPOINT=\"$updater_dev_endpoint\"",
    "UPDATER_PROD_ENDPOINT=\"$updater_prod_endpoint\"",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "privacy_preserving_protocol_handler_unittest.cc" ]
  deps = [
    ":test_util",
    "//components/update_client",
    "//testing/gtest",

    # The build fails without this dep, even though our source doesn't use it.
    "//base",
  ]
}

source_set("test_util") {
  testonly = true
  sources = [
    "test_util.cc",
    "test_util.h",
  ]
  deps = [
    "//base",
    "//components/prefs",
    "//components/prefs:test_support",
    "//components/update_client",
    "//third_party/re2",
  ]
}
