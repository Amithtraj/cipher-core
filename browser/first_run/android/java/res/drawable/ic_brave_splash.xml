<!-- SecureOut Browser onboarding splash mark. Replaces the original Brave
     lion mascot artwork with a simple neutral shield + "S" mark, matching
     the placeholder style used elsewhere in this project (solid #3B2FD9
     fill, white "S" stroke). The "brave_logo" group name and pivot are kept
     unchanged since ic_brave_splash_animated.xml's scale animator targets
     this group by name. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="288"
    android:viewportHeight="288"
    tools:ignore="VectorRaster">
  <group
      android:name="brave_logo"
      android:pivotX="144"
      android:pivotY="144">
  <path
      android:pathData="M43.2,34.56 L244.8,34.56 L244.8,144 L144,264.96 L43.2,144 Z"
      android:fillColor="#FF3B2FD9"/>
  <path
      android:pathData="M192,85.33 C192,85.33 165.33,58.67 133.33,64 C101.33,69.33 80,90.67 85.33,117.33 C90.67,144 128,149.33 154.67,160 C181.33,170.67 208,181.33 202.67,208 C197.33,234.67 160,240 128,229.33 C101.33,220 85.33,202.67 85.33,202.67"
      android:fillColor="#00000000"
      android:strokeColor="#FFFFFFFF"
      android:strokeWidth="29.33"
      android:strokeLineCap="round"
      android:strokeLineJoin="round"
      tools:ignore="VectorPath" />
  </group>
</vector>
