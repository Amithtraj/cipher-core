<!-- SecureOut Browser onboarding splash mark. Replaces the original Brave
     lion mascot artwork with a simple neutral shield + "S" mark, matching
     the placeholder style used elsewhere in this project (solid #3B2FD9
     fill, white "S" stroke). The "brave_logo" group name and pivot are kept
     unchanged since ic_brave_splash_animated.xml's scale animator targets
     this group by name. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="288"
    android:viewportHeight="288"
    tools:ignore="VectorRaster">
  <group
      android:name="brave_logo"
      android:pivotX="144"
      android:pivotY="144">
  <path
      android:pathData="M43.2,34.56 L244.8,34.56 L244.8,144 L144,264.96 L43.2,144 Z"
      android:fillColor="#FF3B2FD9"/>
  <path
      android:pathData="M175.2,105.86 C175.2,105.86 157.86,88.54 137.06,92 C116.26,95.46 102.4,109.34 105.86,126.66 C109.34,144 133.6,147.46 150.94,154.4 C168.26,161.34 185.6,168.26 182.14,185.6 C178.66,202.94 154.4,206.4 133.6,199.46 C116.26,193.4 105.86,182.14 105.86,182.14"
      android:fillColor="#00000000"
      android:strokeColor="#FFFFFFFF"
      android:strokeWidth="19.06"
      android:strokeLineCap="round"
      android:strokeLineJoin="round"
      tools:ignore="VectorPath" />
  </group>
</vector>
